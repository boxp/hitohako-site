---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ひとはこ | 変身ヒロイン / バーチャルソフトウェアエンジニア巫女さん',
  description =
    'ひとはこさん（VTuber）のポートフォリオサイト。プロフィール・仲間・STG 1CC 記録・リンク。和風 × 90年代レトロゲーム風。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a0b2e" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site?.toString() ?? 'https://hitohako.b0xp.io'} />
    <meta property="og:image" content="/pixel/hitohako-face.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="crt">
    <a
      href="#menu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:bg-gold focus:text-ink focus:px-3 focus:py-1"
      >メニューへスキップ</a
    >
    <slot />
  </body>
</html>
